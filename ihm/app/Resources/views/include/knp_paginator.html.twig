{% if pagination is defined and pagination is not empty %}
    <div class="row">
        <div class="col-xs-4">
            <div class="count">
                {% set totalItem = pagination.getTotalItemCount %}
                Total : {{ totalItem }} {{ (totalItem > 1)?'éléments':'élément' }}
            </div>
        </div>
        <div class="col-sm-8">
            <div class="navigation pull-right">
                {{ knp_pagination_render(pagination) }}
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
{% endif %}