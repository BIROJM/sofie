namespace Sofie\ExpBundle\Entity;


use Doctrine\ORM\Event\LifecycleEventArgs;
use Doctrine\ORM\Event\PreFlushEventArgs;

class VenuEauPrincipale
{
    const SYNC = 'Y';
    const NO_SYNC = 'N';

    /**
     * @var integer
     */
    private $id;

    /**
     * @var string
     */
    private $profondeur;

    /**
     * @var string
     */
    private $debitCumule;

    /**
     * @var string
     */
    private $sync;

    /**
     * @var \DateTime
     */
    private $deletedAt;

    /**
     * @var \DateTime
     */
    private $createdAt;

    /**
     * @var \DateTime
     */
    private $updatedAt;

    /**
     * @var \Sofie\ExpBundle\Entity\Ouvrage
     */
    private $ouvrage;

    /**
     * Ces deux variables sont utilis�es pour l'ajout via l'api
     */
    static private $indice = 0;
    private $position;


    public function __construct()
    {
        $this->sync = static::NO_SYNC;
        $this->position = static::$indice++;
    }


    /**
     * Set id
     *
     * @param integer $id
     * @return VenuEauPrincipale
     */
    public function setId($id)
    {
        $this->id = $id;

        return $this;
    }

    /**
     * Get id
     *
     * @return integer 
     */
    public function getId()
    {
        return $this->id;
    }

    /**
     * Set profondeur
     *
     * @param string $profondeur
     * @return VenuEauPrincipale
     */
    public function setProfondeur($profondeur)
    {
        $this->profondeur = $profondeur;

        return $this;
    }

    /**
     * Get profondeur
     *
     * @return string 
     */
    public function getProfondeur()
    {
        return $this->profondeur;
    }

    /**
     * Set debitCumule
     *
     * @param string $debitCumule
     * @return VenuEauPrincipale
     */
    public function setDebitCumule($debitCumule)
    {
        $this->debitCumule = $debitCumule;

        return $this;
    }

    /**
     * Get debitCumule
     *
     * @return string 
     */
    public function getDebitCumule()
    {
        return $this->debitCumule;
    }

    /**
     * Set sync
     *
     * @param string $sync
     * @return VenuEauPrincipale
     */
    public function setSync($sync)
    {
        $this->sync = $sync;

        return $this;
    }

    /**
     * Get sync
     *
     * @return string 
     */
    public function getSync()
    {
        return $this->sync;
    }

    /**
     * Set deletedAt
     *
     * @param \DateTime $deletedAt
     * @return VenuEauPrincipale
     */
    public function setDeletedAt($deletedAt)
    {
        $this->deletedAt = $deletedAt;

        return $this;
    }

    /**
     * Get deletedAt
     *
     * @return \DateTime 
     */
    public function getDeletedAt()
    {
        return $this->deletedAt;
    }

    /**
     * Set createdAt
     *
     * @param \DateTime $createdAt
     * @return VenuEauPrincipale
     */
    public function setCreatedAt($createdAt)
    {
        $this->createdAt = $createdAt;

        return $this;
    }

    /**
     * Get createdAt
     *
     * @return \DateTime 
     */
    public function getCreatedAt()
    {
        return $this->createdAt;
    }

    /**
     * Set updatedAt
     *
     * @param \DateTime $updatedAt
     * @return VenuEauPrincipale
     */
    public function setUpdatedAt($updatedAt)
    {
        $this->updatedAt = $updatedAt;

        return $this;
    }

    /**
     * Get updatedAt
     *
     * @return \DateTime 
     */
    public function getUpdatedAt()
    {
        return $this->updatedAt;
    }

    /**
     * Set ouvrage
     *
     * @param \Sofie\ExpBundle\Entity\Ouvrage $ouvrage
     * @return VenuEauPrincipale
     */
    public function setOuvrage(\Sofie\ExpBundle\Entity\Ouvrage $ouvrage = null)
    {
        $this->ouvrage = $ouvrage;

        return $this;
    }

    /**
     * Get ouvrage
     *
     * @return \Sofie\ExpBundle\Entity\Ouvrage 
     */
    public function getOuvrage()
    {
        return $this->ouvrage;
    }

    /**
     * @ORM\PrePersist
     */
    public function setCreatedValue()
    {
        $this->createdAt = new \DateTime();
        $this->updatedAt = $this->createdAt;
    }

    /**
     * @ORM\PrePersist
     */
    public function setCustomId(LifecycleEventArgs $eventArgs)
    {
        if($this->id == null){
            $this->id = $eventArgs->getEntityManager()->getRepository('SofieExpBundle:VenuEauPrincipale')->getNextId()+$this->position;
        }
    }

    /**
     * @ORM\PreUpdate
     */
    public function setUpdatedValue()
    {
        $this->updatedAt = new \DateTime();
        $this->unsynchronize();
    }

    public function synchronize()
    {
        $this->sync = static::SYNC;
        return $this;
    }

    public function unsynchronize()
    {
        $this->sync = self::NO_SYNC;
        return $this;
    }

    /**
     * @ORM\PreFlush
     */
    public function setPreFlushValue(PreFlushEventArgs $eventArgs)
    {
        $em = $eventArgs->getEntityManager();
        if($this->ouvrage==null){
            $em->remove($this);
            $em->flush();
        }
    }

    public function getPosition()
    {
        return $this->position;
    }

    public function setPosition($position)
    {
        $this->position = $position;
    }
}
