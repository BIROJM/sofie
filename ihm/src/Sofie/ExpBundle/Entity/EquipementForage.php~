<?php

namespace Sofie\ExpBundle\Entity;

use Doctrine\ORM\Event\LifecycleEventArgs;
use Doctrine\ORM\Event\PreFlushEventArgs;


/**
 * EquipementForage
 */
class EquipementForage
{
    const SYNC = 'Y';
    const NO_SYNC = 'N';

    /**
     * @var integer
     */
    private $id;

    /**
     * @var string
     */
    private $nature;

    /**
     * @var string
     */
    private $profSup;

    /**
     * @var string
     */
    private $profInf;

    /**
     * @var string
     */
    private $diametre;


    /**
     * @var \Sofie\ExpBundle\Entity\Ouvrage
     */
    private $ouvrage;

    /**
     * @var \DateTime
     */
    private $createdAt;

    /**
     * @var \DateTime
     */
    private $updatedAt;

    /**
     * @var string
     */
    private $sync;

    /**
     * @var \DateTime
     */
    private $deletedAt;

    /**
     * Ces deux variables sont utilisées pour l'ajout via l'api
     */
    static private $indice = 0;
    private $position;


    public function __construct()
    {
        $this->sync = static::NO_SYNC;
        $this->position = static::$indice++;
    }

    /**
     * Get id
     *
     * @return integer
     */
    public function getId()
    {
        return $this->id;
    }

    public function setId($id)
    {
        $this->id = $id;
    }

    /**
     * Set nature
     *
     * @param string $nature
     * @return EquipementForage
     */
    public function setNature($nature)
    {
        $this->nature = $nature;

        return $this;
    }

    /**
     * Get nature
     *
     * @return string 
     */
    public function getNature()
    {
        return $this->nature;
    }

    /**
     * Set profSup
     *
     * @param string $profSup
     * @return EquipementForage
     */
    public function setProfSup($profSup)
    {
        $this->profSup = $profSup;

        return $this;
    }

    /**
     * Get profSup
     *
     * @return string 
     */
    public function getProfSup()
    {
        return $this->profSup;
    }

    /**
     * Set profInf
     *
     * @param string $profInf
     * @return EquipementForage
     */
    public function setProfInf($profInf)
    {
        $this->profInf = $profInf;

        return $this;
    }

    /**
     * Get profInf
     *
     * @return string 
     */
    public function getProfInf()
    {
        return $this->profInf;
    }

    /**
     * Set diametre
     *
     * @param string $diametre
     * @return EquipementForage
     */
    public function setDiametre($diametre)
    {
        $this->diametre = $diametre;

        return $this;
    }

    /**
     * Get diametre
     *
     * @return string 
     */
    public function getDiametre()
    {
        return $this->diametre;
    }

    /**
     * Set ouvrage
     *
     * @param \Sofie\ExpBundle\Entity\Ouvrage $ouvrage
     * @return EquipementForage
     */
    public function setOuvrage(\Sofie\ExpBundle\Entity\Ouvrage $ouvrage = null)
    {
        $this->ouvrage = $ouvrage;

        return $this;
    }

    /**
     * Get ouvrage
     *
     * @return \Sofie\ExpBundle\Entity\Ouvrage 
     */
    public function getOuvrage()
    {
        return $this->ouvrage;
    }

    /**
     * Set createdAt
     *
     * @param \DateTime $createdAt
     * @return EquipementForage
     */
    public function setCreatedAt($createdAt)
    {
        $this->createdAt = $createdAt;

        return $this;
    }

    /**
     * Get createdAt
     *
     * @return \DateTime 
     */
    public function getCreatedAt()
    {
        return $this->createdAt;
    }

    /**
     * Set updatedAt
     *
     * @param \DateTime $updatedAt
     * @return EquipementForage
     */
    public function setUpdatedAt($updatedAt)
    {
        $this->updatedAt = $updatedAt;

        return $this;
    }

    /**
     * Get updatedAt
     *
     * @return \DateTime 
     */
    public function getUpdatedAt()
    {
        return $this->updatedAt;
    }

    /**
     * Set sync
     *
     * @param string $sync
     * @return EquipementForage
     */
    public function setSync($sync)
    {
        $this->sync = $sync;

        return $this;
    }

    /**
     * Get sync
     *
     * @return string 
     */
    public function getSync()
    {
        return $this->sync;
    }

    public function setCreatedValue()
    {
        $this->createdAt = new \DateTime();
        $this->updatedAt = $this->createdAt;
    }

    public function setUpdatedValue()
    {
        $this->updatedAt = new \DateTime();
    }

    public function setPreFlushValue(PreFlushEventArgs $eventArgs)
    {
        $em = $eventArgs->getEntityManager();
        if($this->ouvrage==null){
            $em->remove($this);
            $em->flush();
        }
    }

    public function setCustomId(LifecycleEventArgs $eventArgs)
    {
        if($this->id == null){
            $this->id = $eventArgs->getEntityManager()->getRepository('SofieExpBundle:EquipementForage')->getNextId()+$this->position;
        }
    }

    public function getPosition()
    {
        return $this->position;
    }

    public function setPosition($position)
    {
        $this->position = $position;
    }

    public function synchronize()
    {
        $this->sync = static::SYNC;
    }

    /**
     * Set deletedAt
     *
     * @param \DateTime $deletedAt
     * @return EquipementForage
     */
    public function setDeletedAt($deletedAt)
    {
        $this->deletedAt = $deletedAt;

        return $this;
    }

    /**
     * Get deletedAt
     *
     * @return \DateTime 
     */
    public function getDeletedAt()
    {
        return $this->deletedAt;
    }
}
