{% extends '::pdf.html.twig' %}

{% block title %}Listes des régions{% endblock %}

{% block data_source %}Régions{% endblock %}
{% block data_length %}{{ regions|default([])|length }}{% endblock %}

{% block sofie_pdf_body %}
    {{ pdf.start_list_table() }}
        <thead>
            <tr>
                <th>#</th>
                <th>Nom</th>
               <!-- <th>Superficie</th>-->
               <!-- <th>Situation</th>-->
                <th>Longitude</th>
                <th>Latitude</th>
                <th>Directeur</th>
                <th>Sociologue</th>
            </tr>
        </thead>
        {% if regions is defined %}
            {% if regions is not empty %}
                <tbody>
                {% set page_inc = g_paginator_items|default(0)*(page|default(1)-1) %}
                {% for region in regions %}
                    <tr>
                        <td>{{ loop.index+page_inc|default(0) }}</td>
                        <td>{{ region.nom|default('') }}</td>
                       <!--  <td>{{ region.superficie|default('') }}</td>-->
                        <!-- <td>{{ region.situation|default('') }}</td>-->
                        <td>{{ region.longitude|default('') }}</td>
                        <td>{{ region.latitude|default('') }}</td>
                        <td>{{ region.iddr|default('') }}</td>
                        <td>{{ region.sociologue|default('') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            {% endif %}
        {% endif %}
    {{ pdf.end_list_table() }}
{% endblock %}