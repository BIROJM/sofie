{% import '::macro/links.html.twig' as links %}

<div class="table-responsive">
    <table class="table table-striped table-bordered table-hover table-heading">
        <caption>
            <div class="pull-right">
                {{ links.pdf_link({}, {'class':'fa-2x'}) }}
            </div>
        </caption>
        <thead>
        <tr class="tabHeader">
            <th>#</th>
            <th>Nom</th>
            <!--<th>Superficie</th>-->
             <!--<th>Situation</th>--> 
            <th>Longitude</th>
            <th>Latitude</th>
            <th>Directeur</th>
            <th>Sociologue</th>
            <th>Actions</th>
        </tr>
        </thead>
        {% if regions is defined %}
            {% if regions is not empty %}
                <tbody>
                    {% set page_inc = g_paginator_items*(page-1) %}
                    {% for region in regions %}
                        <tr>
                            <td>{{ loop.index+page_inc|default(0) }}</td>
                            <td>{{ region.nom|default('') }}</td>
                          <!--  <td>{{ region.superficie|default('') }}</td>-->
                          <!--  <td>{{ region.situation|default('') }}</td>-->
                            <td>{{ region.longitude|default('') }}</td>
                            <td>{{ region.latitude|default('') }}</td>
                            <td>{{ region.iddr|default('') }}</td>
                            <td>{{ region.sociologue|default('') }}</td>
                            <td class="text-center">
                                <a class="text-info" href="{{ path('sofieexp_region_view', {'id':region.id|default(0)}) }}" title="Voir">
                                    <i class="fa fa-eye"></i>
                                </a>
                                {% if is_granted('ROLE_EDIT_REGION') %}
                                    <a class="text-success" href="{{ path('sofieexp_region_edit', {'id':region.id|default(0)}) }}" title="Modifier">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            {% endif %}
        {% endif %}
    </table>
</div>
{# Pagination #}
{% include '::include/paginator/paginator.html.twig' with {'total': regions|default([])|length} %}
