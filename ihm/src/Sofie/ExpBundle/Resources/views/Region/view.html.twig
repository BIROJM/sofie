{% extends 'SofieExpBundle:Region:index.html.twig' %}

{% block breadcrumb %}
    {{ parent() }}
    <li><a href="{{ path('sofieexp_region_view', {'id':region.id|default(0)}) }}">Voir une région</a></li>
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-sm-12">
            <div class="box">
                <div class="box-header">
                    <div class="box-name">
                        <i class="fa fa-info-circle"></i>
                        <span class ="titleHeader">Détails sur région</span>
                    </div>
                    <div class="no-move"></div>
                </div>
                <div class="box-content">
                    {% if region is defined %}
                        <div id="tabsview">
                            <ul>
                                <li><a href="#tabs-1">Informations générales</a></li>
                                <li><a href="#tabs-2" class="load-carte-region">Voir la carte</a></li>
                            </ul>
                            <div id="tabs-1">

                                {% import '::macro/tr_views.html.twig' as trViews %}

                                <div class="row">
                                    <div class="col-md-6 col-sm-8 col-xs-12">
                                        <div class="table-responsive">
                                            <table class="table table-striped table-hover tabHeader">
                                                {{ trViews.tr('Nom :', region.nom|default('')) }}
                                                {{
                                                    trViews.entity_tr(
                                                        "Directeur :", region.iddr|default(''), {
                                                            'role': 'ROLE_AGENT',
                                                            'path': path('sofieexp_agent_view', {'id':region.iddr.id|default(0)})
                                                        }
                                                    )
                                                }}
                                                {{
                                                    trViews.entity_tr(
                                                        "Sociologue :", region.sociologue|default(''), {
                                                            'role': 'ROLE_AGENT',
                                                            'path': path('sofieexp_agent_view', {'id':region.sociologue.id|default(0)})
                                                        }
                                                    )
                                                }}
                                                {{ trViews.tr('Superficie :', region.superficie|default('')) }}
                                                {{ trViews.tr('Situation :', region.situation|default('')) }}
                                                {{ trViews.tr('Longitude :', region.longitude|default('')) }}
                                                {{ trViews.tr('Latitude :', region.latitude|default('')) }}
                                                {{ trViews.tr('Zoom max de la carte :', region.maxZoom|default('')) }}
                                                {{ trViews.tr('Nombre de localités :', region.localites|default('')|length) }}
                                                {{ trViews.tr("Nombre d'agents :", region.agents|default('')|length) }}
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <hr class="x-margin" />
                                <div class="clearfix">
                                    <div class="pull-right">
                                        {% if is_granted('ROLE_EDIT_REGION') %}
                                            <a class="text-success" href="{{ path('sofieexp_region_edit', {'id':region.id|default(0)}) }}" title="Modifier">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            <div id="tabs-2">
                                <div id="region-carte" data-carte="{{ g_carte_region_url|default('')~''~region.id|default(0) }}">

                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12">
            <button class="btn btn-default back-location" type="button">
                <i class="fa fa-chevron-left"></i> Retour
            </button>
        </div>
    </div>
{% endblock %}

{% block flash_scripts %}
    <script type="text/javascript">
        $(function(){
            // Create jQuery-UI tabs
            $("#tabsview").tabs();
            $('.load-carte-region').click(function(){
                loadCarteByRegion($('#region-carte'));
            });
        });
    </script>
{% endblock %}