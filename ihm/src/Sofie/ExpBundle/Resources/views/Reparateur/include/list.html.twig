{% import '::macro/links.html.twig' as links %}

<div class="table-responsive">
    <table class="table table-striped table-bordered table-hover table-heading">
        {% if is_granted('ROLE_REPARATEUR') %}
            <caption>
                <div class="pull-right">
                    <a class="btn btn-primary btn-label-left" title="Ajouter" href="{{ path('sofieexp_reparateur_add') }}">
                        <span><i class="fa fa-plus"></i></span> Ajouter
                    </a>
                    <i class="fa fa-ellipsis-v fa-2x"></i>
                    {{ links.pdf_link({}, {'class':'fa-2x'}) }}
                </div>
            </caption>
        {% endif %}
        <thead>
        <tr>
            <th>#</th>
            <th>Nom</th>
            <th>Prénoms</th>
            <th>Initialisé</th>
            <th>C. initialisation</th>
            <th>N° appel</th>
            <th>Nb. localités suivis</th>
            <th>Actions</th>
        </tr>
        </thead>
        {% if reparateurs is defined %}
            {% if reparateurs is not empty %}
                {% import '::macro/view.html.twig' as views %}
                <tbody>
                    {% set page_inc = g_paginator_items|default(0)*(page|default(1)-1) %}
                    {% for reparateur in reparateurs %}
                        <tr>
                            <td>{{ loop.index+page_inc }}</td>
                            <td>{{ reparateur.nom|default('') }}</td>
                            <td>{{ reparateur.prenoms|default('') }}</td>
                            <td class="text-center">
                                {{ views.init_profile(reparateur, path('sofieexp_reparateur_ajax_init', {'id':reparateur.id|default(0)})) }}
                            </td>
                            <td>{{ reparateur.codeInit|default('') }}</td>
                            <td class="profile-number">{{ reparateur.numeroAppel.numero|default('') }}</td>
                            <td class="text-center">{{ reparateur.localites|default([])|length }}</td>
                            <td class="text-center">
                                <a class="text-info" href="{{ path('sofieexp_reparateur_view', {'id': reparateur.id|default(0)}) }}" title="Modifier">
                                    <i class="fa fa-eye"></i>
                                </a>
                                {% if is_granted('ROLE_EDIT_REPARATEUR') %}
                                    <a class="text-success" href="{{ path('sofieexp_reparateur_edit', {'id': reparateur.id|default(0)}) }}" title="Modifier">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                {% endif %}
                                {% if is_granted('ROLE_DELETE_REPARATEUR') %}
                                    <a class="text-danger confirm-delete" href="{{ path('sofieexp_reparateur_delete', {'id': reparateur.id|default(0)}) }}" title="Supprimer">
                                        <i class="fa fa-remove"></i>
                                    </a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            {% endif %}
        {% endif %}
    </table>
</div>
{# Pagination #}
{% include '::include/paginator/paginator.html.twig' with {'total': reparateurs|default([])|length} %}
