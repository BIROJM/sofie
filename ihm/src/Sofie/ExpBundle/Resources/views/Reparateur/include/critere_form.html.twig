{% if form is defined and form is not empty %}
    {{ form_start(form, {'method':'POST', 'attr':{'class':'form-inline', 'role':'form', 'id':'critere'}}) }}
    <div class="row">
        <div class="col-sm-12">
            {% if g_sofie_site|default(null) is null and form.region is defined %}
                <div class="form-group">
                    {{ form_label(form.region, null, {'label_attr':{'class':''}}) }}
                    {{ form_widget(form.region, {'attr':{'class':'inline-select2 form-control'}}) }}
                </div>
            {% endif %}
            {% if form.initStatus is defined %}
                <div class="form-group">
                    {{ form_label(form.initStatus, null, {'label_attr':{'class':''}}) }}
                    {{ form_widget(form.initStatus, {'attr':{'class':'inline-select2 form-control'}}) }}
                </div>
            {% endif %}
            {% if form.codeInit is defined %}
                <div class="form-group">
                    {{ form_label(form.codeInit) }}
                    {{ form_widget(form.codeInit, {'attr':{'class':'form-control'}}) }}
                </div>
            {% endif %}
            {% if form.numeroAppel is defined %}
                <div class="form-group">
                    {{ form_label(form.numeroAppel) }}
                    {{ form_widget(form.numeroAppel, {'attr':{'class':'form-control'}}) }}
                </div>
            {% endif %}
            {% if form.nom is defined %}
                <div class="form-group">
                    {{ form_label(form.nom) }}
                    {{ form_widget(form.nom, {'attr':{'class':'form-control'}}) }}
                </div>
            {% endif %}
            {% if form.prenoms is defined %}
                <div class="form-group">
                    {{ form_label(form.prenoms) }}
                    {{ form_widget(form.prenoms, {'attr':{'class':'form-control'}}) }}
                </div>
            {% endif %}
        </div>
    </div>
    <div>{{ form_widget(form._token) }}</div>
    {% include '::include/critere_submit_button.html.twig' %}
    {{ form_end(form, {'render_rest': false}) }}
{% endif %}