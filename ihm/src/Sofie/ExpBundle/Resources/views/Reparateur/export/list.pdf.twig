{% extends '::pdf.html.twig' %}

{% block title %}Listes des réparateurs{% endblock %}

{% block data_source %}Réparateurs{% endblock %}
{% block data_length %}{{ reparateurs|default([])|length }}{% endblock %}

{% block sofie_pdf_body %}
    {{ pdf.start_list_table() }}
        <thead>
            <tr>
                <th>#</th>
                <th>Nom</th>
                <th>Prénoms</th>
                <th>Initialisé</th>
                <th>C. initialisation</th>
                <th>N° appel</th>
                <th>Nb. localités suivis</th>
            </tr>
        </thead>
        {% if reparateurs is defined %}
            {% if reparateurs is not empty %}
                <tbody>
                {% set page_inc = g_paginator_items|default(0)*(page|default(1)-1) %}
                {% for reparateur in reparateurs %}
                    <tr>
                        <td>{{ loop.index+page_inc }}</td>
                        <td>{{ reparateur.nom|default('') }}</td>
                        <td>{{ reparateur.prenoms|default('') }}</td>
                        <td class="text-center">{{ reparateur.initStatus|default(false)|oui_non }}</td>
                        <td>{{ reparateur.codeInit|default('') }}</td>
                        <td>{{ reparateur.numeroAppel.numero|default('') }}</td>
                        <td class="text-center">{{ reparateur.localites|default([])|length }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            {% endif %}
        {% endif %}
    {{ pdf.end_list_table() }}
{% endblock %}