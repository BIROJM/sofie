{% extends 'SofieExpBundle:Reparateur:index.html.twig' %}

{% block breadcrumb %}
    {{ parent() }}
    <li><a href="{{ path('sofieexp_reparateur_view', {'id': reparateur.id|default(0)}) }}">Voir un réparateur</a></li>
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-sm-12">
            <div class="box">
                <div class="box-header">
                    <div class="box-name">
                        <i class="fa fa-info-circle"></i>
                        <span>Détails sur réparateur</span>
                    </div>
                </div>
                <div class="box-content">
                    {% if reparateur is defined %}

                        {% import '::macro/tr_views.html.twig' as trViews %}

                        <div class="row">
                            <div class="col-md-6 col-sm-8 col-xs-12">
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        {{ trViews.tr('Nom :', reparateur.nom|default('')) }}
                                        {{ trViews.tr('Prénoms :', reparateur.prenoms|default('')) }}
                                        {{ trViews.tr("Numéro d'appel :", reparateur.numeroAppel.numero|default('')) }}
                                        {{ trViews.tr("Code d'initialisation :", reparateur.codeInit|default('')) }}
                                        {{ trViews.raw_tr("Initialisé :", reparateur.initStatus|default(false)|check_init|raw, {
                                            'val': {'class': ''}
                                        }) }}
                                    </table>
                                </div>
                            </div>
                        </div>
                        <hr class="x-margin" />
                        <div class="clearfix">
                            <div class="pull-right">
                                {% if is_granted('ROLE_EDIT_REPARATEUR') %}
                                    <a class="text-success" href="{{ path('sofieexp_reparateur_edit', {'id': reparateur.id|default(0)}) }}" title="Modifier">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                {% endif %}
                                {% if is_granted('ROLE_DELETE_REPARATEUR') %}
                                    <a class="text-danger confirm-delete" href="{{ path('sofieexp_reparateur_delete', {'id': reparateur.id|default(0)}) }}" title="Supprimer">
                                        <i class="fa fa-remove"></i>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12">
            <button class="btn btn-default back-location" type="button">
                <i class="fa fa-chevron-left"></i> Retour
            </button>
        </div>
    </div>
{% endblock %}