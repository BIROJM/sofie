{% extends '::pdf.html.twig' %}

{% block title %}Listes des appels téléphoniques{% endblock %}

{% block data_source %}Appels téléphoniques{% endblock %}
{% block data_length %}{{ appels|default([])|length }}{% endblock %}

{% block sofie_pdf_body %}
    {{ pdf.start_list_table() }}
        <thead>
            <tr>
                <th>#</th>
                <th>Date</th>
                <th>Motif</th>
                <th>N° panne</th>
                <th>N° appel</th>
                <th>Origine</th>
                <th>Emetteur</th>
                <th>C. ouvrage</th>
                <th>Région</th>
            </tr>
        </thead>
        {% if appels is defined %}
            {% if appels is not empty %}
                <tbody>
                {% set page_inc = g_paginator_items|default(0)*(page|default(1)-1) %}
                {% for appel in appels %}
                    <tr>
                        <td>{{ loop.index+page_inc }}</td>
                        <td>
                            {{ (appel.dateAppel|default(null) is not empty) ? appel.dateAppel|date('d/m/Y H:i:s') : '' }}
                        </td>
                        <td>{{ appel.getNormMotif(appel.motif|default(''))|default('') }}</td>
                        <td>{{ appel.panne.numero|default('') }}</td>
                        <td>{{ appel.numeroAppel.numero|default('') }}</td>
                        <td>{{ appel.numeroAppel.profile.designation|default('') }}</td>
                        <td>{{ appel.numeroAppel.emetteur|default('') }}</td>
                        <td>{{ appel.panne.ouvrage.code|default('') }}</td>
                        <td>{{ appel.panne.ouvrage.localite.region|default('') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            {% endif %}
        {% endif %}
    {{ pdf.end_list_table() }}
{% endblock %}