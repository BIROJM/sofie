{% extends "SofieExpBundle::layout.html.twig" %}

{% block nav_appel_active %}active{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li><a href="{{ path('sofieexp_appel_index') }}">Appels téléphoniques</a></li>
{% endblock %}

{% block body %}

    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                    <div class="box-name">
                        <i class="fa fa-table"></i>
                        <span>Liste des appels téléphoniques</span>
                    </div>
                </div>
                <div class="box-content no-padding">
                    <div class="bs-callout content-critere">
                        {% include 'SofieExpBundle:Appel:include/critere_form.html.twig' %}
                    </div>
                    {% include 'SofieExpBundle:Appel:include/list.html.twig' %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script type="text/javascript" src="{{ asset('bundles/sofieexp/js/appel.js') }}"></script>
{% endblock %}
