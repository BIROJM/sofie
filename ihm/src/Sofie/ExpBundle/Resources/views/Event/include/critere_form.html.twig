<form class="form-inline" role="form">
    <div class="row">
        <div class="col-sm-12">
            <div class="form-group">
                Du
                <input type="text" class="form-control date-picker" placeholder="Date de début">
            </div>
            <div class="form-group">
                au
                <input type="text" class="form-control date-picker" placeholder="Date de fin">
            </div>
            <div class="form-group">
                Type :
                <select class="form-control">
                    <option>Trier par type :</option>
                    <option>Type 1</option>
                    <option>Type 2</option>
                    <option>Type 3</option>
                    <option>Type 4</option>
                    <option>Type 5</option>
                </select>
            </div>
            <div class="form-group">
                Ouvrage :
                <select class="form-control">
                    <option>Trier par ouvrage :</option>
                    <option>Ouvrage 1</option>
                    <option>Ouvrage 2</option>
                    <option>Ouvrage 3</option>
                    <option>Ouvrage 4</option>
                    <option>Ouvrage 5</option>
                </select>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12">
            <button type="submit" class="btn btn-default">
                Afficher
            </button>
        </div>
    </div>
</form>