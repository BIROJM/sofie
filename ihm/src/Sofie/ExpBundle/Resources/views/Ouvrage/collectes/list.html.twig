<div class="table-responsive">
    <table class="table table-striped table-bordered table-hover table-heading">

        {% import '::macro/links.html.twig' as links %}

        {% if is_granted('ROLE_ADD_COLLECTE') %}
            <caption>
                <div class="pull-right">
                    <a class="btn btn-primary btn-label-left" href="{{ path('sofieexp_collecte_add', {'id':ouvrage.id|default(0)}) }}" title="Ajouter une collecte">
                        <span><i class="fa fa-plus"></i></span> Ajouter
                    </a>
                    <i class="fa fa-ellipsis-v fa-2x"></i>
                    {{ links.pdf_link({}, {'class':'fa-2x'}) }}
                </div>
            </caption>
        {% endif %}
        <thead>
        <tr>
            <th>Date de saisie</th>
            <th>Opérateur</th>
            <th>Agent de saisie</th>
            <th>Service</th>
            <th>Etat de l'ouvrage</th>
            <th>Validé</th>
            <th>Origine</th>
            <th>Actions</th>
        </tr>
        </thead>
        {% if ouvrage is defined and collectes is defined %}
            {% if collectes is not empty %}
                {% import '::macro/view.html.twig' as views %}
                <tbody>
                    {% for collecte in collectes %}
                        <tr>
                            <td>
                                {% if collecte.dateSaisie|default(null) is not empty %}
                                    {{ collecte.dateSaisie|date('d/m/Y') }}
                                {% endif %}
                            </td>
                            <td>{{ collecte.nomOperateur|default('') }}</td>
                            <td>{{ collecte.nomAgentSaisie|default('') }}</td>
                            <td>{{ collecte.service|default('') }}</td>
                            <td>{{ collecte.etatOuvrage|default('') }}</td>
                            <td class="text-center">
                                {{ views.validate_action(collecte, path('sofieexp_collecte_ajax_validate', {'id':collecte.id|default(0)})) }}
                            </td>
                            <td class="text-center">{{ collecte.origin|default('I')|origine|raw }}</td>
                            <td class="text-center">
                                <a class="text-info" href="{{ path('sofieexp_collecte_view', {'id':collecte.id|default(0)}) }}" title="Voir">
                                    <i class="fa fa-eye"></i>
                                </a>
                                {% if is_granted('ROLE_EDIT_COLLECTE') %}
                                    <a class="text-success" href="{{ path('sofieexp_collecte_edit', {'id':collecte.id|default(0)}) }}" title="Modifier">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                {% endif %}
                                {% if is_granted('ROLE_DELETE_COLLECTE') %}
                                    <a class="text-danger confirm-delete" href="{{ path('sofieexp_collecte_delete', {'id':collecte.id|default(0)}) }}" title="Supprimer">
                                        <i class="fa fa-remove"></i>
                                    </a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            {% endif %}
        {% endif %}
    </table>
</div>

{# Pagination #}
{% include '::include/paginator/paginator.html.twig' with {'total': collectes|default([])|length} %}

