{% extends '::pdf.html.twig' %}

{% block title %}Listes des collectes{% endblock %}

{% block data_source %}Collectes{% endblock %}
{% block data_length %}{{ collectes|default([])|length }}{% endblock %}

{% block sofie_pdf_body %}
    {{ pdf.start_list_table() }}
        <thead>
            <tr>
                <th>Date de saisie</th>
                <th>Opérateur</th>
                <th>Agent de saisie</th>
                <th>Service</th>
                <th>Etat de l'ouvrage</th>
                <th>Validé</th>
            </tr>
        </thead>
        {% if collectes is defined %}
            {% if collectes is not empty %}
                <tbody>
                {% set page_inc = g_paginator_items|default(0)*(page|default(1)-1) %}
                {% for collecte in collectes %}
                    <tr>
                        <td>
                            {% if collecte.dateSaisie|default(null) is not empty %}
                                {{ collecte.dateSaisie|date('d/m/Y') }}
                            {% endif %}
                        </td>
                        <td>{{ collecte.nomOperateur|default('') }}</td>
                        <td>{{ collecte.nomAgentSaisie|default('') }}</td>
                        <td>{{ collecte.service|default('') }}</td>
                        <td>{{ collecte.etatOuvrage|default('') }}</td>
                        <td>{{ collecte.validated|default(false)|oui_non }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            {% endif %}
        {% endif %}
    {{ pdf.end_list_table() }}
{% endblock %}