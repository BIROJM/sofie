{% if form is defined and form is not empty %}
    {{ form_start(form, {'method':'POST', 'attr':{'class':'form-inline', 'role':'form', 'id':'critere'}}) }}
        <div class="row">
            <div class="col-sm-12">
                {% if form.dateApp is defined %}
                    <div class="form-group">
                        {{ form_label(form.dateApp) }}
                        {{ form_widget(form.dateApp, {'attr':{'class':'daterange-picker'}}) }}
                    </div>
                {% endif %}
                {% if form.datePriseCharge is defined %}
                    <div class="form-group">
                        {{ form_label(form.datePriseCharge) }}
                        {{ form_widget(form.datePriseCharge, {'attr':{'class':'daterange-picker'}}) }}
                    </div>
                {% endif %}
                {% if form.dateDebutRep is defined %}
                    <div class="form-group">
                        {{ form_label(form.dateDebutRep) }}
                        {{ form_widget(form.dateDebutRep, {'attr':{'class':'daterange-picker'}}) }}
                    </div>
                {% endif %}
                {% if form.dateReparation is defined %}
                    <div class="form-group">
                        {{ form_label(form.dateReparation) }}
                        {{ form_widget(form.dateReparation, {'attr':{'class':'daterange-picker'}}) }}
                    </div>
                {% endif %}
                {% if form.type is defined %}
                    <div class="form-group">
                        {{ form_label(form.type) }}
                        {{ form_widget(form.type, {'attr':{'class':'inline-select2 form-control'}}) }}
                    </div>
                {% endif %}
                {% if form.numero is defined %}
                    <div class="form-group">
                        {{ form_label(form.numero) }}
                        {{ form_widget(form.numero, {'attr':{'class':'form-control'}}) }}
                    </div>
                {% endif %}
            </div>
        </div>

        <div>{{ (form._token is defined) ? form_widget(form._token) : '' }}</div>

        {% include '::include/critere_submit_button.html.twig' %}
    {{ form_end(form, {'render_rest': false}) }}
{% endif %}