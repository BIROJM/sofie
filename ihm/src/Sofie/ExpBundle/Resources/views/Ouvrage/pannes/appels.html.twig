{% import '::macro/links.html.twig' as links %}

<div class="table-responsive">
    <table class="table table-striped table-bordered table-hover table-heading">
        <caption>
            <div class="pull-right">
                {{ links.pdf_link({}, {'class':'fa-lg'}) }}
            </div>
        </caption>
        <thead>
        <tr>
            <th>#</th>
            <th>Date</th>
            <th>Motif</th>
            <th>Numéro d'appel</th>
            <th>Origine</th>
            <th>Emetteur</th>
        </tr>
        </thead>
        {% if appels is defined %}
            {% if appels is not empty %}
                <tbody>
                    {% for appel in appels %}
                        <tr>
                            <td>{{ loop.index }}</td>
                            <td>
                                {% if appel.dateAppel|default(null) is not empty %}
                                    {{ appel.dateAppel|date('d/m/Y H:is') }}
                                {% endif %}
                            </td>
                            <td>{{ appel.getNormMotif(appel.motif|default(''))|default('') }}</td>
                            <td>{{ appel.numeroAppel.numero|default('') }}</td>
                            <td>{{ appel.numeroAppel.profile.designation|default('') }}</td>
                            <td>{{ appel.numeroAppel.emetteur|default('') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            {% endif %}
        {% endif %}
    </table>
</div>