{{
    form_start(form, {
        'action':'', 'method':'POST',
        'attr':{'class':'form-horizontal', 'role':'form'}
    })
}}
    <div class="text-danger small">{{ form_errors(form) }}</div>
    <div class="row">
        <div class="col-sm-6">
            {% if form.dateSaisie is defined %}
                <div class="form-group has-feedback">
                    {{ form_label(form.dateSaisie, null, {'label_attr':{'class':'col-sm-4 control-label'}}) }}
                    <div class="col-sm-6">
                        {{ form_widget(form.dateSaisie, {'attr':{'class':'form-control date-picker',  value :  'now'|date('d/m/Y')  }}) }}
                        <span class="fa fa-calendar form-control-feedback"></span>
                        <div class="text-danger small">{{ form_errors(form.dateSaisie) }}</div>
                    </div>
                </div>
            {% endif %}
        </div>
        <div class="col-sm-6">
            {% if form.operateurSaisie is defined %}
                <div class="form-group">
                    {{ form_label(form.operateurSaisie, null, {'label_attr':{'class':'col-sm-4 control-label'}}) }}
                    <div class="col-sm-8">
                        {{ form_widget(form.operateurSaisie, {'attr':{'class':'form-control'}}) }}
                    </div>
                    <div class="col-sm-offset-4 text-danger small">{{ form_errors(form.operateurSaisie) }}</div>
                </div>
            {% endif %}
        </div>
    </div>
    <hr class="x-margin" />
