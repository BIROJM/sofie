                                        <tr>
                                            <td>{{ form_widget(equipementForage.nature, {'attr':{'class':'form-control'}}) }}</td>
                                            <td>{{ form_widget(equipementForage.profSup, {'attr':{'class':'form-control'}}) }}</td>
                                            <td>{{ form_widget(equipementForage.profInf, {'attr':{'class':'form-control'}}) }}</td>
                                            <td>{{ form_widget(equipementForage.diametre, {'attr':{'class':'form-control'}}) }}</td>
