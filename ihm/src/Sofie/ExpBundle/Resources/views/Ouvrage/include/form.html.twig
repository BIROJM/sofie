                                <table class="table table-bordered">
                                    <caption>
                                        Equipement du forage : Tubage plein ( P ) et Crépines ( C )
                                    </caption>
                                    <thead>
                                    <tr>
                                        <th>{{ form_label(form.equipementForages.vars.prototype.nature, null, {'label_attr':{'class':'control-label'}}) }}</th>
