                            </div>
                            <div class="col-sm-offset-4 text-danger small">{{ form_errors(form.localite) }}</div>
                        </div>
                    {% endif %}
                    {% if comites is defined %}
                        <div class="form-group">
                            <label for="sofie_expbundle_ouvrage_comite" class="col-sm-4 control-label">Comité</label>
                            <div class="col-sm-8">
                                <select id="sofie_expbundle_ouvrage_comite"
                                        class="select2 form-control" name="sofie_expbundle_ouvrage_comite" data-current-id="{{ currentId|default(0) }}">
                                    <option></option>
                                    {% for comite in comites|default([]) %}
                                        <option value="{{ comite.id|default(null) }}" {% if comite==form.vars.value.comite|default(null) %}selected{% endif %}>
                                            {{ comite.nom|default('') }}
                                        </option>
                                    {% endfor %}
                                </select>
                                {% if form.comite is defined %}
                                    <div class="text-danger small">{{ form_errors(form.comite) }}</div>
                                    {% do form.comite.setRendered %}
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                    {% if form.prefecture is defined %}
                        <div class="form-group">
                            {{ form_label(form.prefecture, null, {'label_attr':{'class':'col-sm-4 control-label'}}) }}
                            <div class="col-sm-8">
