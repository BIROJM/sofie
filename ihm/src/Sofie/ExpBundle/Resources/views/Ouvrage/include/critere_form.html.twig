{% if form is defined and form is not empty %}
    {{ form_start(form, {'method':'POST', 'attr':{'class':'form-inline', 'role':'form', 'id':'critere'}}) }}
        <div class="row">
            <div class="col-sm-12">
                {% if g_sofie_site|default(null) is null and form.region is defined %}
                    <div class="form-group">
                        {{ form_label(form.region) }}
                        {{ form_widget(form.region, {'attr':{'class':'inline-select2 form-control'}}) }}
                    </div>
                {% endif %}
                {% if form.localite is defined %}
                    <div class="form-group">
                        {{ form_label(form.localite) }}
                        {{ form_widget(form.localite, {'attr':{'class':'inline-select2 form-control'}}) }}
                    </div>
                {% endif %}
                {% if form.statutOuvrage is defined %}
                    <div class="form-group">
                        {{ form_label(form.statutOuvrage) }}
                        {{ form_widget(form.statutOuvrage, {'attr':{'class':'inline-select2 form-control'}}) }}
                    </div>
                {% endif %}
                {% if form.validated is defined %}
                    <div class="form-group">
                        {{ form_label(form.validated) }}
                        {{ form_widget(form.validated, {'attr':{'class':'inline-select2 form-control'}}) }}
                    </div>
                {% endif %}
                {% if form.code is defined %}
                    <div class="form-group">
                        {{ form_label(form.code) }}
                        {{ form_widget(form.code, {'attr':{'class':'form-control'}}) }}
                    </div>
                {% endif %}
                {% if form.numIRH is defined %}
                    <div class="form-group">
                        {{ form_label(form.numIRH) }}
                        {{ form_widget(form.numIRH, {'attr':{'class':'form-control'}}) }}
                    </div>
                {% endif %}
            </div>
        </div>
        <div>{{ (form._token is defined) ? form_widget(form._token) : '' }}</div>
        {% include '::include/critere_submit_button.html.twig' %}
    {{ form_end(form, {'render_rest': false}) }}
{% endif %}