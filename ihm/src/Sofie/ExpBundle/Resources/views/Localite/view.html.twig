{% extends 'SofieExpBundle:Localite:index.html.twig' %}

{% block breadcrumb %}
    {{ parent() }}
    <li><a href="{{ app.request.requestUri }}">Voir une localité</a></li>
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-sm-12">
            <div class="box">
                <div class="box-header">
                    <div class="box-name">
                        <i class="fa fa-info-circle"></i>
                        <span>Détails sur localité</span>
                    </div>
                </div>
                <div class="box-content">
                    {% if localite is defined %}

                        {% import '::macro/tr_views.html.twig' as trViews %}

                        <div class="row">
                            <div class="col-sm-8">
                                <div class="table-responsive">
                                    <table class="table table-hover table-striped">
                                        {{ trViews.tr('Nom :', localite.nom|default('')) }}
                                        {{ trViews.tr("Nombre d'habitant :", localite.nombreHabitant|default('')) }}
                                        {{
                                            trViews.entity_tr(
                                                "Région :", localite.region.nom|default(''), {
                                                    'role': 'ROLE_REGION',
                                                    'path': path('sofieexp_region_view', {'id':localite.region.id|default(0)})
                                                }
                                            )
                                        }}
                                        {{
                                            trViews.entity_tr(
                                                "Réparateur :", localite.reparateur.fullname|default(''), {
                                                    'role': 'ROLE_REPARATEUR',
                                                    'path': path('sofieexp_reparateur_view', {'id':localite.reparateur.id|default(0)})
                                                }
                                            )
                                        }}
                                        {{
                                            trViews.entity_tr(
                                                "Agent Formen :", localite.agentForma|default(''), {
                                                    'role': 'ROLE_AGENT',
                                                    'path': path('sofieexp_agent_view', {'id':localite.agentForma.id|default(0)})
                                                }
                                            )
                                        }}
                                        {{ trViews.tr("Nombre d'ouvrages :", localite.ouvrages|default('')|length) }}
                                        {{ trViews.tr("Nombre de comités :", localite.comites|default('')|length) }}
                                    </table>
                                </div>
                            </div>
                        </div>
                        <hr class="x-margin" />
                        <div class="clearfix">
                            <div class="pull-right">
                                {% if is_granted('ROLE_EDIT_LOCALITE') %}
                                    <a class="text-success" href="{{ path('sofieexp_localite_edit', {'id':localite.id|default(0)}) }}" title="Modifier">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                {% endif %}
                                {% if is_granted('ROLE_DELETE_LOCALITE') %}
                                    <a class="text-danger confirm-delete" href="{{ path('sofieexp_localite_delete', {'id':localite.id|default(0)}) }}" title="Supprimer">
                                        <i class="fa fa-remove"></i>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12">
            <button class="btn btn-default back-location" type="button">
                <i class="fa fa-chevron-left"></i> Retour
            </button>
        </div>
    </div>
{% endblock %}