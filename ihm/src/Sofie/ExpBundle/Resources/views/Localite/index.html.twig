{% extends 'SofieExpBundle::layout.html.twig' %}

{% block nav_localite_active %}active{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li><a href="{{ path('sofieexp_localite_index') }}">Localités</a></li>
{% endblock %}

{% block body %}

    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                    <div class="box-name">
                        <i class="fa fa-table"></i>
                        <span>Liste des localités</span>
                    </div>
                </div>
                <div class="box-content no-padding">
                    {% if g_sofie_site|default(null) is null %}
                        <div class="bs-callout content-critere">
                            {% include 'SofieExpBundle:Localite:include/critere_form.html.twig' %}
                        </div>
                    {% endif %}
                    {% include 'SofieExpBundle:Localite:include/list.html.twig' %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script type="text/javascript" src="{{ asset('bundles/sofieexp/js/localite.js') }}"></script>
{% endblock %}

{% block flash_scripts %}
    <script type="text/javascript">
        $(function(){
            critereListener();
        });
    </script>
{% endblock %}
