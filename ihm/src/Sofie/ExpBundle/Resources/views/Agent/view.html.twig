{% extends 'SofieExpBundle:Agent:index.html.twig' %}

{% block breadcrumb %}
    {{ parent() }}
    <li><a href="{{ path('sofieexp_agent_view', {'id': agent.id|default(0)}) }}">Voir un agent</a></li>
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-sm-12">
            <div class="box">
                <div class="box-header">
                    <div class="box-name">
                        <i class="fa fa-info-circle"></i>
                        <span>Détails sur agent</span>
                    </div>
                </div>
                <div class="box-content">
                    {% import '::macro/tr_views.html.twig' as trViews %}
                    {% if agent is defined %}
                        <div class="row">
                            <div class="col-md-6 col-xs-12">
                                {% include 'SofieUserBundle:User:include/agent_view.html.twig' %}
                            </div>
                            {% if agent.user is defined %}
                                <div class="col-md-6 col-xs-12">
                                    {% include 'SofieUserBundle:User:include/user_view.html.twig' with {'user':agent.user} %}
                                </div>
                            {% endif %}
                        </div>
                        <hr class="x-margin" />
                        <div class="clearfix">
                            <div class="pull-right">
                                {% if is_granted('ROLE_EDIT_AGENT') %}
                                    <a class="text-success" href="{{ path('sofieexp_agent_edit', {'id':agent.id|default(0)}) }}" title="Modifier">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                {% endif %}
                                {% if is_granted('ROLE_DELETE_AGENT') %}
                                    <a class="text-danger confirm-delete" href="{{ path('sofieexp_agent_delete', {'id':agent.id|default(0)}) }}" title="Supprimer">
                                        <i class="fa fa-remove"></i>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12">
            <button class="btn btn-default back-location" type="button">
                <i class="fa fa-chevron-left"></i> Retour
            </button>
        </div>
    </div>
{% endblock %}