{% extends '::pdf.html.twig' %}

{% block title %}Listes des agents{% endblock %}

{% block data_source %}Agents{% endblock %}
{% block data_length %}{{ agents|default([])|length }}{% endblock %}

{% block sofie_pdf_body %}
    {{ pdf.start_list_table() }}
        <thead>
            <tr>
                <th>#</th>
                <th>Nom</th>
                <th>Prénoms</th>
                <th>Initialisé</th>
                <th>C. initialisation</th>
                <th>Qualification</th>
                <th>N° appel</th>
                <th>Région</th>
            </tr>
        </thead>
        {% if agents is defined %}
            {% if agents is not empty %}
                <tbody>
                {% set page_inc = g_paginator_items|default(0)*(page|default(1)-1) %}
                {% for agent in agents %}
                    <tr>
                        <td>{{ loop.index+page_inc }}</td>
                        <td>{{ agent.nom|default('') }}</td>
                        <td>{{ agent.prenoms|default('') }}</td>
                        <td>
                            {% if agent.mustInitialized()|default(false) %}
                                {{ agent.initStatus|default(false)|oui_non }}
                            {% endif %}
                        </td>
                        <td>{{ agent.codeInit|default('') }}</td>
                        <td>{{ agent.qualification|default('') }}</td>
                        <td>{{ agent.numeroAppel.numero|default('') }}</td>
                        <td>
                            {{ agent.region.nom|default('') }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            {% endif %}
        {% endif %}
    {{ pdf.end_list_table() }}
{% endblock %}