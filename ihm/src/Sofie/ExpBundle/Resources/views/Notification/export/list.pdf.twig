{% extends '::pdf.html.twig' %}

{% block title %}Listes des notifications{% endblock %}

{% block data_source %}Notifications{% endblock %}
{% block data_length %}{{ notifications|default([])|length }}{% endblock %}

{% block sofie_pdf_body %}
    {{ pdf.start_list_table() }}
        <thead>
            <tr>
                <th>#</th>
                <th>Date</th>
                <th>Motif</th>
                <th>Origine</th>
                <th>Nom & Prénoms</th>
            </tr>
        </thead>
        {% if notifications is defined %}
            {% if notifications is not empty %}
                <tbody>
                {% set page_inc = g_paginator_items|default(0)*(page|default(1)-1) %}
                {% for notification in notifications %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td>
                            {% if notification.dateHeureNotif|default(null) is not empty %}
                                {{ notification.dateHeureNotif|date('d/m/Y H:i:s') }}
                            {% endif %}
                        </td>
                        <td>{{ notification.getNormMotif(notification.motif|default(''))|default('') }}</td>
                        <td>{{ notification.numeroAppel.profile.designation|default('') }}</td>
                        <td>{{ notification.numeroAppel.proprietaire|default('') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            {% endif %}
        {% endif %}
    {{ pdf.end_list_table() }}
{% endblock %}