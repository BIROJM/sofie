{% extends 'SofieExpBundle:Comite:index.html.twig' %}

{% block breadcrumb %}
    {{ parent() }}
    <li><a href="{{ app.request.requestUri }}">Editer un comité</a></li>
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-xs-12 col-sm-12">
            <div class="box">
                <div class="box-header">
                    <div class="box-name">
                        <i class="fa fa-search"></i>
                        <span>Edition d'un comité</span>
                    </div>
                </div>
                {% if form is defined and form is not empty %}
                    <div class="box-content">
                        {% include 'SofieExpBundle:Comite:include/form.html.twig' %}

                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{% block flash_scripts %}
    <script type="text/javascript">
        $(function(){
            regionListener($('#sofie_expbundle_comite_region'), $('#sofie_expbundle_comite_localite'));
        });
    </script>
{% endblock %}

