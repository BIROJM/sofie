{% extends 'SofieExpBundle::layout.html.twig' %}

{% block nav_comite_active %}active{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li><a href="{{ path('sofieexp_comite_index') }}">Comités</a></li>
{% endblock %}

{% block body %}

    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                    <div class="box-name">
                        <i class="fa fa-table"></i>
                        <span>Liste des comités</span>
                    </div>
                </div>
                <div class="box-content no-padding">
                    <div class="bs-callout content-critere">
                        {% include 'SofieExpBundle:Comite:include/critere_form.html.twig' %}
                    </div>
                    {% include 'SofieExpBundle:Comite:include/list.html.twig' %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script type="text/javascript" src="{{ asset('bundles/sofieexp/js/comite.js') }}"></script>
{% endblock %}

{% block flash_scripts %}
    <script type="text/javascript">
        $(function(){
            critereListener();
            regionListener($('#form_region'), $('#form_localite'));
            initProfileListener();
        });
    </script>
{% endblock %}

