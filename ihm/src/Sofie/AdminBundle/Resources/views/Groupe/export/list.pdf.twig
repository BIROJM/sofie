{% extends '::pdf.html.twig' %}

{% block title %}Listes des groupes d'utilisateurs{% endblock %}

{% block data_source %}Groupes d'utilisateurs{% endblock %}
{% block data_length %}{{ groupes|default([])|length }}{% endblock %}

{% block sofie_pdf_body %}
    {{ pdf.start_list_table() }}
        <thead>
            <tr>
                <th>#</th>
                <th>Nom du groupe</th>
                <th>Nb. utilisateurs</th>
            </tr>
        </thead>
        {% if groupes is defined %}
            {% if groupes is not empty %}
                <tbody>
                {% set page_inc = g_paginator_items|default(0)*(page|default(1)-1) %}
                {% for groupe in groupes %}
                    <tr>
                        <td>{{ loop.index+page_inc }}</td>
                        <td>{{ groupe.name|default('') }}</td>
                        <td class="text-center">{{ groupe.userGroupes|default('')|length }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            {% endif %}
        {% endif %}
    {{ pdf.end_list_table() }}
{% endblock %}