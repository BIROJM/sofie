{% if regions is defined and regions is not empty %}
    <form action="{{ path('sofieadmin_param_regionsmodemconfig') }}" method="post" class="form-horizontal" id="regionsModemConfig" role="form">
        <div class="table-responsive">
            <table class="table">
                <thead>
                <tr>
                    <th>Région</th><th>Numéro du modem</th>
                </tr>
                </thead>
                <tbody>
                {% for region in regions|default([]) %}
                    <tr>
                        <td>
                            {{ region.nom|default('') }}
                        </td>
                        <td>
                            <input type="text" name="regions[{{ region.id|default(0) }}]" class="form-control"
                                   id="regions_{{ region.id|default(0) }}" value="{{ region.numeroModem|default('') }}" />
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="form-group">
            <div class="col-sm-2">
                <button type="submit" class="btn btn-success btn-label-left">
                    <span><i class="fa fa-clock-o"></i></span>
                    Enrégistrer
                </button>
            </div>
        </div>
    </form>
{% endif %}