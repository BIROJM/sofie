{% extends '::pdf.html.twig' %}

{% block title %}Listes des utilisateurs{% endblock %}

{% block data_source %}Utilisateurs{% endblock %}
{% block data_length %}{{ users|default([])|length }}{% endblock %}

{% block sofie_pdf_body %}
    {{ pdf.start_list_table() }}
        <thead>
            <tr>
                <th>#</th>
                <th>Nom d'utilisateur</th>
                <th>Email</th>
                <th>Nom & prénoms</th>
                <th>Qualification</th>
                {% if g_sofie_site|default(null) is null %}
                    <th>Region</th>
                {% endif %}
            </tr>
        </thead>
        {% if users is defined %}
            {% if users is not empty %}
                <tbody>
                {% set page_inc = g_paginator_items|default(0)*(page|default(1)-1) %}
                {% for user in users %}
                    <tr>
                        <td>{{ loop.index+page_inc }}</td>
                        <td>{{ user.username|default('') }}</td>
                        <td>{{ user.email|default('') }}</td>
                        <td>{{ user.agent|default('') }}</td>
                        <td>{{ user.agent.qualification|default('') }}</td>
                        {% if g_sofie_site|default(null) is null %}
                            <td>{{ user.agent.region|default('') }}</td>
                        {% endif %}
                    </tr>
                {% endfor %}
                </tbody>
            {% endif %}
        {% endif %}
    {{ pdf.end_list_table() }}
{% endblock %}