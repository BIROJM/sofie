{{
    form_start(form, {
        'action':'', 'method':'POST',
        'attr':{'class':'form-horizontal', 'role':'form'}
    })
}}
    <div class="text-danger small">{{ form_errors(form) }}</div>
    <div class="col-sm-6">
        {% if form.username is defined %}
            <div class="form-group">
                {{ form_label(form.username, null, {'label_attr':{'class':'col-sm-4 control-label'}}) }}
                <div class="col-sm-8">
                    {{ form_widget(form.username, {'attr':{'class':'form-control'}}) }}
                    <div class="text-muted small">
                        Peut contenir des lettres, des chiffres et le caractère underscore (_).
                        Doit obligatoirement commencer par un lettre.
                    </div>
                    <div class="text-danger small">{{ form_errors(form.username) }}</div>
                </div>
            </div>
        {% endif %}
        {% if form.plainPassword is defined %}
            <div class="form-group">
                {{ form_label(form.plainPassword.first, null, {'label_attr':{'class':'col-sm-4 control-label'}}) }}
                <div class="col-sm-8">
                    {{ form_widget(form.plainPassword.first, {'attr':{'class':'form-control'}}) }}
                    <div class="text-muted small">Au minimum 6 caractères.</div>
                    <div class="text-danger small">{{ form_errors(form.plainPassword.first) }}</div>
                </div>
            </div>
            <div class="form-group">
                {{ form_label(form.plainPassword.second, null, {'label_attr':{'class':'col-sm-4 control-label'}}) }}
                <div class="col-sm-8">
                    {{ form_widget(form.plainPassword.second, {'attr':{'class':'form-control'}}) }}
                </div>
            </div>
        {% endif %}
        {% if form.email is defined %}
            <div class="form-group">
                {{ form_label(form.email, null, {'label_attr':{'class':'col-sm-4 control-label'}}) }}
                <div class="col-sm-8">
                    {{ form_widget(form.email, {'attr':{'class':'form-control'}}) }}
                    <div class="text-danger small">{{ form_errors(form.email) }}</div>
                </div>
            </div>
        {% endif %}
        {% if form.admin is defined %}
            <div class="form-group">
                <div class="col-sm-8 col-sm-offset-4">
                    <div class="checkbox">
                        <label for="{{ form.admin.vars.id }}">
                            {{ form_widget(form.admin) }}
                            {{ form.admin.vars.label }}
                            <i class="fa fa-square-o small"></i>
                        </label>
                    </div>
                </div>
                <div class="text-danger small">{{ form_errors(form.admin) }}</div>
            </div>
        {% endif %}
        {% if form.isMobile is defined %}
            <div class="form-group">
                <div class="col-sm-8 col-sm-offset-4">
                    <div class="checkbox">
                        <label for="{{ form.isMobile.vars.id }}">
                            {{ form_widget(form.isMobile) }}
                            {{ form.isMobile.vars.label }}
                            <i class="fa fa-square-o small"></i>
                        </label>
                    </div>
                </div>
                <div class="text-danger small">{{ form_errors(form.isMobile) }}</div>
            </div>
        {% endif %}
        {% if form.isActive is defined %}
            <div class="form-group">
                <div class="col-sm-8 col-sm-offset-4">
                    <div class="checkbox">
                        <label for="{{ form.isActive.vars.id }}">
                            {{ form_widget(form.isActive) }}
                            {{ form.isActive.vars.label }}
                            <i class="fa fa-square-o small"></i>
                        </label>
                    </div>
                </div>
                <div class="text-danger small">{{ form_errors(form.isActive) }}</div>
            </div>
        {% endif %}
    </div>
    <div class="col-sm-6">
        {% if g_sofie_site|default(null) is null and form.region is defined %}
            <div class="form-group">
                {{ form_label(form.region, null, {'label_attr':{'class':'col-sm-4 control-label'}}) }}
                <div class="col-sm-8">
                    {{ form_widget(form.region, {'attr':{'class':'select2 form-control'}}) }}
                    <div class="text-danger small">{{ form_errors(form.region) }}</div>
                </div>
            </div>
        {% endif %}
        {% if form.agent is defined %}
            <div class="form-group">
                {{ form_label(form.agent, null, {'label_attr':{'class':'col-sm-4 control-label'}}) }}
                <div class="col-sm-8">
                    {{ form_widget(form.agent, {'attr':{'class':'select2 form-control'}}) }}
                    <div class="text-danger small">{{ form_errors(form.agent) }}</div>
                </div>
            </div>
        {% endif %}
        {% if form.groupes is defined %}
            <div class="form-group">
                {{ form_label(form.groupes, null, {'label_attr':{'class':'col-sm-4 control-label'}}) }}
                <div class="col-sm-8">
                    {{ form_widget(form.groupes, {'attr':{'class':'select2 form-control'}}) }}
                    <div class="text-danger small">{{ form_errors(form.groupes) }}</div>
                </div>
            </div>
        {% endif %}
    </div>
    <div class="clearfix"></div>
    {% include '::include/default_form_buttons.html.twig' %}
    <div>
        {{ form_rest(form) }}
    </div>
{{ form_end(form) }}