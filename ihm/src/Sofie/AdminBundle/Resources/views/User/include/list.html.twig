{% import '::macro/links.html.twig' as links %}

<div class="table-responsive">
    <table class="table table-striped table-bordered table-hover table-heading">
        {% if is_granted('ROLE_USER_VIEW') %}
            <caption>
                <div class="pull-right">
                    <a class="btn btn-primary btn-label-left" title="Ajouter" href="{{ path('sofieadmin_user_add') }}">
                        <span><i class="fa fa-plus"></i></span> Ajouter
                    </a>
                    <i class="fa fa-ellipsis-v fa-2x"></i>
                    {{ links.pdf_link({}, {'class':'fa-2x'}) }}
                </div>
            </caption>
        {% endif %}
        <thead>
        <tr>
            <th>#</th>
            <th>Nom d'utilisateur</th>
            <th>Email</th>
            <th>Nom & prénoms</th>
            <th>Qualification</th>
            {% if g_sofie_site|default(null) is null %}
                <th>Region</th>
            {% endif %}
            <th>Actions</th>
        </tr>
        </thead>
        {% if users is defined %}
            {% if users is not empty %}
                <tbody>
                    {% set page_inc = g_paginator_items*(page-1) %}
                    {% for user in users %}
                        {% if not user.admin|default(false) or is_granted('ROLE_ADMIN') %}
                            <tr>
                                <td>{{ loop.index+page_inc }}</td>
                                <td>
                                    {{- user.username|default('') }}
                                    {{ user.isMobile|default(false)|mobile|raw }}
                                    {{ user.admin|default(false)|admin|raw }}
                                    {{ user.isActive|default(false)|inactive|raw -}}
                                </td>
                                <td>{{ user.email|default('') }}</td>
                                <td>
                                    {% if is_granted('ROLE_AGENT') %}
                                        <a href="{{ path('sofieexp_agent_view', {'id':user.agent.id|default(0)}) }}">
                                            {{ user.agent|default('') }}
                                        </a>
                                    {% else %}
                                        {{ user.agent|default('') }}
                                    {% endif %}
                                </td>
                                <td>{{ user.agent.qualification|default('') }}</td>
                                {% if g_sofie_site|default(null) is null %}
                                    <td>
                                        {% if is_granted('ROLE_REGION') %}
                                            <a href="{{ path('sofieexp_region_view', {'id':user.agent.region.id|default(0)}) }}">
                                                {{ user.agent.region|default('') }}
                                            </a>
                                        {% else %}
                                            {{ user.agent.region|default('') }}
                                        {% endif %}
                                    </td>
                                {% endif %}
                                <td class="text-center">
                                    <a class="text-info" href="{{ path('sofieadmin_user_view', {'id':user.id|default(0)}) }}" title="Voir">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                    {% if is_granted('ROLE_EDIT_USER') %}
                                        <a class="text-success" href="{{ path('sofieadmin_user_edit', {'id':user.id|default(0)}) }}" title="Modifier">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                    {% endif %}
                                    {% if is_granted('ROLE_DELETE_USER') %}
                                        <a class="text-danger confirm-delete" href="{{ path('sofieadmin_user_delete', {'id':user.id|default(0)}) }}" title="Supprimer">
                                            <i class="fa fa-remove"></i>
                                        </a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                </tbody>
            {% endif %}
        {% endif %}
    </table>
</div>
{# Pagination #}
{% include '::include/paginator/paginator.html.twig' with {'total': users|default([])|length} %}