{% extends "SofieAdminBundle::layout.html.twig" %}

{% block nav_user_active %}active{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li><a href="{{ path('sofieadmin_user_index') }}">Utilisateurs</a></li>
{% endblock %}

{% block body %}

    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                    <div class="box-name">
                        <i class="fa fa-table"></i>
                        <span>Liste des utilisateurs</span>
                    </div>
                    <div class="no-move"></div>
                </div>
                <div class="box-content no-padding">
                    <div class="bs-callout content-critere">
                        {% include 'SofieAdminBundle:User:include/critere_form.html.twig' %}
                    </div>
                    {% include 'SofieAdminBundle:User:include/list.html.twig' %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script type="text/javascript" src="{{ asset('bundles/sofieadmin/js/user.js') }}"></script>
{% endblock %}
