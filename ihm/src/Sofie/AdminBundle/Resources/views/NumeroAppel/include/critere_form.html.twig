{% if form is defined and form is not empty %}
    {{ form_start(form, {'method':'POST', 'attr':{'class':'form-inline', 'role':'form', 'id':'critere'}}) }}
    <div class="row">
        <div class="col-sm-12">
            {% if form.numero is defined %}
                <div class="form-group">
                    {{ form_label(form.numero) }}
                    {{ form_widget(form.numero, {'attr':{'class':'form-control'}}) }}
                </div>
            {% endif %}
            {% if form.profile is defined %}
                <div class="form-group">
                    {{ form_label(form.profile) }}
                    {{ form_widget(form.profile, {'attr':{'class':'inline-select2 form-control'}}) }}
                </div>
            {% endif %}
            {% if form.acteur is defined %}
                <div class="form-group">
                    {{ form_label(form.acteur) }}
                    {{ form_widget(form.acteur, {'attr':{'class':'inline-select2 form-control'}}) }}
                </div>
            {% endif %}
        </div>
    </div>
    <div>{{ form_widget(form._token) }}</div>
    {% include '::include/critere_submit_button.html.twig' %}
    {{ form_end(form, {'render_rest': false}) }}
{% endif %}