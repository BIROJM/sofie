{% import '::macro/links.html.twig' as links %}

<div class="table-responsive">
    <table class="table table-striped table-bordered table-hover table-heading">
        <caption>
            <div class="pull-right">
                {{ links.pdf_link({}, {'class':'fa-lg'}) }}
            </div>
        </caption>
        <thead>
        <tr>
            <th>#</th>
            <th>Date</th>
            <th>Motif</th>
        </tr>
        </thead>
        {% if notifications is defined %}
            {% if notifications is not empty %}
                <tbody>
                    {% set page_inc = g_paginator_items*(page-1) %}
                    {% for notification in notifications %}
                        <tr>
                            <td>{{ loop.index+page_inc }}</td>
                            <td>
                                {% if notification.dateHeureNotif is defined and notification.dateHeureNotif is not empty %}
                                    {{ notification.dateHeureNotif|date('d/m/Y H:i:s') }}
                                {% endif %}
                            </td>
                            <td>{{ notification.getNormMotif(notification.motif|default(''))|default('') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            {% endif %}
        {% endif %}
    </table>
</div>
{# Pagination #}
{% include '::include/paginator/paginator.html.twig' with {'total':notifications|default([])|length} %}