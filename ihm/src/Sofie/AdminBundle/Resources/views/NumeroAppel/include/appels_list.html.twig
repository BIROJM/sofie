{% import '::macro/links.html.twig' as links %}

<div class="table-responsive">
    <table class="table table-striped table-bordered table-hover table-heading">
        <caption>
            <div class="pull-right">
                {{ links.pdf_link({}, {'class':'fa-lg'}) }}
            </div>
        </caption>
        <thead>
        <tr>
            <th>#</th>
            <th>Date</th>
            <th>Motif</th>
        </tr>
        </thead>
        {% if appels is defined %}
            {% if appels is not empty %}
                <tbody>
                    {% set page_inc = g_paginator_items*(page-1) %}
                    {% for appel in appels %}
                        <tr>
                            <td>{{ loop.index+page_inc }}</td>
                            <td>
                                {% if appel.dateAppel is defined and appel.dateAppel is not empty %}
                                    {{ appel.dateAppel|date('d/m/Y H:i:s') }}
                                {% endif %}
                            </td>
                            <td>{{ appel.getNormMotif(appel.motif|default(''))|default('') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            {% endif %}
        {% endif %}
    </table>
</div>
{# Pagination #}
{% include '::include/paginator/paginator.html.twig' with {'total': appels|default([])|length} %}