{{
    form_start(form, {
        'action':'', 'method':'POST',
        'attr':{'class':'form-horizontal', 'role':'form'}
    })
}}
    <div class="text-danger small">{{ form_errors(form) }}</div>
    {% if form.currentPassword is defined %}
        <div class="form-group">
            {{ form_label(form.currentPassword, null, {'label_attr':{'class':'col-sm-4 control-label'}}) }}
            <div class="col-sm-8">
                {{ form_widget(form.currentPassword, {'attr':{'class':'form-control'}}) }}
                <div class="text-danger small">{{ form_errors(form.currentPassword) }}</div>
            </div>
        </div>
    {% endif %}
    {% if form.newPassword is defined %}
        <div class="form-group">
            {{ form_label(form.newPassword.first, null, {'label_attr':{'class':'col-sm-4 control-label'}}) }}
            <div class="col-sm-8">
                {{ form_widget(form.newPassword.first, {'attr':{'class':'form-control'}}) }}
                <div class="text-muted small">Au minimum 6 caractères.</div>
                <div class="text-danger small">{{ form_errors(form.newPassword.first) }}</div>
            </div>
        </div>
        <div class="form-group">
            {{ form_label(form.newPassword.second, null, {'label_attr':{'class':'col-sm-4 control-label'}}) }}
            <div class="col-sm-8">
                {{ form_widget(form.newPassword.second, {'attr':{'class':'form-control'}}) }}
            </div>
        </div>
    {% endif %}
    <div class="clearfix"></div>
    <div class="form-group">
        <div class="col-sm-offset-4 col-sm-2">
            <button type="submit" class="btn btn-success btn-label-left">
                <span><i class="fa fa-check"></i></span>
                Enrégister
            </button>
        </div>
    </div>
    <div>
        {{ form_rest(form) }}
    </div>
{{ form_end(form) }}