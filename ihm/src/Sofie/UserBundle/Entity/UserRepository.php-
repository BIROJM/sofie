<?php

namespace Sofie\UserBundle\Entity;

use Doctrine\ORM\EntityRepository;
use Doctrine\ORM\QueryBuilder;
use Doctrine\ORM\Tools\Pagination\Paginator;
use Sofie\AdminBundle\Entity\Config;
use Sofie\AdminBundle\Model\ParameterFile;
use Sofie\ExpBundle\Entity\Pagination;
use Sofie\ExpBundle\Entity\Profile;
use Sofie\ExpBundle\Entity\Region;
use Symfony\Component\Security\Core\User\UserInterface;
use Symfony\Component\Security\Core\User\UserProviderInterface;
use Symfony\Component\Security\Core\Exception\UsernameNotFoundException;
use Symfony\Component\Security\Core\Exception\UnsupportedUserException;

/**
 * UserRepository
 *
 * This class was generated by the Doctrine ORM. Add your own custom
 * repository methods below.
 */
class UserRepository extends EntityRepository implements UserProviderInterface
{

    public function getNextId()
    {
        return intval($this->createQueryBuilder('u')->select('MAX(u.id)')->getQuery()->getSingleScalarResult())+1;
    }

    public function loadUserByUsername($username)
    {
        $qb = $this->createDefaultBuilder();
        $user = $qb->where('u.username = :username OR u.email = :email')
            ->setParameter('username', $username)
            ->setParameter('email', $username)
            ->getQuery()
            ->getOneOrNullResult();

        if (null === $user) {
            $message = sprintf(
                'Unable to find an active admin AppBundle:User object identified by "%s".',
                $username
            );
            throw new UsernameNotFoundException($message);
        }

        return $user;
    }

    public function refreshUser(UserInterface $user)
    {
        $class = get_class($user);
        if (!$this->supportsClass($class)) {
            throw new UnsupportedUserException(
                sprintf(
                    'Instances of "%s" are not supported.',
                    $class
                )
            );
        }

        return $this->find($user->getId());
    }

    public function supportsClass($class)
    {
        return $this->getEntityName() === $class
        || is_subclass_of($class, $this->getEntityName());
    }


    public function getAll($offset=Config::DEFAULT_OFFSET_PAGINATOR, $page = 1)
    {
        return Pagination::renderPagination($this->getAllQuery(), $offset, $page);
    }

    public function get($id)
    {
        $qb = $this->createDefaultBuilder();
        $qb->leftJoin('ug.groupe', 'g')
                ->addSelect('g')
            ->leftJoin('g.groupeDroits', 'gd')
//                ->addSelect('gd')
            ->andWhere($qb->expr()->eq('u.id', ':id'))
                ->setParameter('id', intval($id))
        ;
        return $qb->getQuery()->getOneOrNullResult();
    }

    public  function getAllQuery()
    {
        $qb = $this->createDefaultBuilder();
        $qb = $this->myDefaultOrder($qb);
        return $qb->getQuery();
    }

    public function getFullByCriteres(array $criteres=array())
    {
        return $this->getCritereQuery($criteres)->getResult();
    }

    public function getByCriteres(array $criteres=array(), $offset=Config::DEFAULT_OFFSET_PAGINATOR, $page=1)
    {
        return Pagination::renderPagination($this->getCritereQuery($criteres), $offset, $page);
    }

    public function getCritereQuery(array $criteres = array())
    {
        $qb = $this->createDefaultBuilder();

        // Critère région
        if(array_key_exists('region', $criteres)){
            $qb = $this->critereRegion($qb, $criteres['region']);
        }
        // Critère qualification
        if(array_key_exists('qualification', $criteres)){
            $qb = $this->critereQualification($qb, $criteres['qualification']);
        }
        // Critère email
        if(array_key_exists('email', $criteres) && $criteres['email'] != ''){
            $qb = $this->critereEmail($qb, $criteres['email']);
        }
        // Critère nom
        if(array_key_exists('nom', $criteres) && $criteres['nom'] != ''){
            $qb = $this->critereNom($qb, $criteres['nom']);
        }
        // Critère prenoms
        if(array_key_exists('prenoms', $criteres) && $criteres['prenoms'] != ''){
            $qb = $this->criterePrenoms($qb, $criteres['prenoms']);
        }
        // Critère status
        if(array_key_exists('status', $criteres) && $criteres['status'] != ''){
            $qb = $this->critereStatus($qb, $criteres['status']);
        }

        $qb = $this->myDefaultOrder($qb);
        return $qb->getQuery();
    }

    protected function critereRegion(QueryBuilder $qb, Region $region = null)
    {
        if($region){
            $qb->andWhere($qb->expr()->eq('r', ':region'))->setParameter('region', $region);
        }
        return $qb;
    }

    protected function critereQualification(QueryBuilder $qb, Profile $qualification = null)
    {
        if(!empty($qualification)){
            $qb->andWhere($qb->expr()->eq('q', ':qualification'))->setParameter('qualification', $qualification);
        }
        return $qb;
    }

    protected function critereEmail(QueryBuilder $qb, $email)
    {
        if($email != ''){
            $qb->andWhere($qb->expr()->like('u.email', $qb->expr()->literal($email.'%')));
        }
        return $qb;
    }

    protected function critereNom(QueryBuilder $qb, $nom)
    {
        if($nom != ''){
            $qb->andWhere($qb->expr()->like('a.nom', $qb->expr()->literal($nom.'%')));
        }
        return $qb;
    }

    protected function criterePrenoms(QueryBuilder $qb, $prenoms)
    {
        if($prenoms != ''){
            $qb->andWhere($qb->expr()->like('a.prenoms', $qb->expr()->literal($prenoms.'%')));
        }
        return $qb;
    }

    protected function critereStatus(QueryBuilder $qb, $status = null)
    {
        if(!is_null($status) && $status != ''){
            if($status==0){
                $qb->andWhere(
                    $qb->expr()->orX(
                        $qb->expr()->eq('u.isActive', ':status'),
                        $qb->expr()->isNull('u.isActive')
                    )
                )
                    ->setParameter('status', intval($status))
                ;
            }else{
                $qb->andWhere($qb->expr()->eq('u.isActive', ':status'))->setParameter('status', intval($status));
            }

        }
        return $qb;
    }

    public function getByUserRegionBuilder()
    {
        $qb = $this->createQueryBuilder('u')
//            ->leftJoin('u.agent', 'a')
        ;
//        return $this->myDefaultFilter($qb);
        return $qb;
    }

    protected function myDefaultSelectAll(QueryBuilder $qb)
    {
        $qb->leftJoin('u.userGroupes', 'ug')
                ->addSelect('ug')
            ->leftJoin('u.agent', 'a')
                ->addSelect('a')
            ->leftJoin('a.region', 'r')
                ->addSelect('r')
            ->leftJoin('a.qualification', 'q')
                ->addSelect('q')
        ;

        return $qb;
    }

    protected function createDefaultBuilder()
    {
        $qb = $this->createQueryBuilder('u');
        $qb = $this->myDefaultSelectAll($qb);
        $qb = $this->myDefaultFilter($qb);
        return $qb;
    }

    protected function myDefaultOrder(QueryBuilder $qb)
    {
        $qb->orderBy('u.id', 'DESC');

        return $qb;
    }

    protected function myDefaultFilter(QueryBuilder $qb)
    {
        $site = ParameterFile::loadSite();
        if(!is_null($site) && $site){
            $qb->leftJoin('a.region', 'r')
                ->andWhere($qb->expr()->eq('r.id', ':region'))
                ->setParameter('region', $site)
            ;
        }
        return $qb;
    }
}
