{
	"name": "sofie/web",
	"description": "Interface web de gestion SOFIE",
	"keywords": ["togo", "sofie", "forage"],
	"license": "proprietary",
	"authors": [
        {
            "name": "Mobisoft",
            "homepage": "http://www.mobisoft.ci"
        }
    ],
	"require": {
		"laravel/framework": "4.1.*",
		"barryvdh/laravel-ide-helper": "1.11.x-dev"
	},
	"require-dev":
	{
    "barryvdh/laravel-debugbar": "1.*"
	},
	"autoload": {
		"classmap": [
			"app/commands",
			"app/controllers",
			"app/models",
			"app/database/migrations",
			"app/database/seeds",
			"app/tests/TestCase.php"
		],
		"psr-0": {
		"Lib": "app"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"php artisan clear-compiled",
			"php artisan optimize"
		],
		"post-update-cmd": [
			"php artisan clear-compiled",
			"php artisan optimize"
		],
		"post-create-project-cmd": [
			"php artisan key:generate"
		]
	},
	"config": {
		"preferred-install": "dist"
	},
	"minimum-stability": "stable"
}
